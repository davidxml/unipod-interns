# Server Runtime
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-deployment.vercel.app

# Database Configuration (PostgreSQL)
# Local Docker instance:
DATABASE_URL=postgresql://user:password@localhost:5432/unipod_db
# Render / Managed instance example:
# DATABASE_URL=postgresql://user:password@dpg-xxxx.render.com/unipod_db

# Cloudflare R2 (S3-Compatible Object Storage)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=unipod-media
R2_PUBLIC_DOMAIN=https://media.yourdomain.com

# Admin Authentication & Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440